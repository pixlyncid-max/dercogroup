{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "lint": "eslint resources/js",
        "format": "prettier --write \"resources/**/*.{ts,tsx,css}\"",
        "format:check": "prettier --check \"resources/**/*.{ts,tsx,css}\"",
        "types": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource-variable/dm-sans": "^5.3.0",
        "@inertiajs/react": "^3.11.0",
        "animejs": "^4.5.0",
        "lucide-react": "^1.70.0",
        "motion": "^12.6.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^9.22.0",
        "@playwright/test": "^1.51.0",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.0.1",
        "eslint": "^9.22.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.0.0",
        "jsdom": "^26.0.0",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.5.3",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0",
        "vite": "^7.0.7",
        "vitest": "^3.0.8"
    }
}
